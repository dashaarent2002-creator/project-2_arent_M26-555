[0.256431, "o", "\u001b[?2004h"]
[0.257008, "o", "\u001b[0;32m@dashaarent2002-creator \u001b[0m➜ \u001b[1;34m/workspaces/project-2_arent_M26-555 \u001b[0;36m(\u001b[1;31mmain\u001b[0;36m) \u001b[0m$ "]
[17.690181, "o", "\u001b[7mdatabase\u001b[27m"]
[21.032245, "o", "\b\b\b\b\b\b\b\bdatabase\r\n\u001b[?2004l\r"]
[21.063458, "o", "\r\n***База данных***\r\n\r\n***Процесс работы с таблицей***\r\nФункции:\r\n"]
[21.063653, "o", "<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n\r\n***Операции с данными***\r\nФункции:\r\n<command> insert into <имя_таблицы> values (<значение1>, <значение2>, ...) - создать запись.\r\n<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать записи по условию.\r\n<command> select from <имя_таблицы> - прочитать все записи.\r\n<command> update <имя_таблицы> set <столбец1> = <новое_значение1> where <столбец_условия> = <значение_условия> - обновить запись.\r\n<command> delete from <имя_таблицы> where <столбец> = <значение> - удалить запись.\r\n<command> info <имя_таблицы> - вывести информацию о таблице.\r\n\r\nОбщие команды:\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\n\r\n>>>Введите команду: "]
[32.456428, "o", "create_table users name:str age:int is_active:bool"]
[33.248506, "o", "\r\n"]
[33.248919, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[33.248969, "o", ">>>Введите команду: "]
[42.211675, "o", "list_tables"]
[42.883531, "o", "\r\n- users"]
[42.884224, "o", "\r\n>>>Введите команду: "]
[54.995866, "o", "insert into users values (\"Sergei\", 28, true)"]
[56.180361, "o", "\r\nФункция insert выполнилась за 0.000 секунд.\r\nЗапись с ID=1 успешно добавлена в таблицу \"users\".\r\n>>>Введите команду: "]
[65.33663, "o", "select from users"]
[66.165614, "o", "\r\n"]
[66.167679, "o", "Функция select выполнилась за 0.000 секунд.\r\n"]
[66.187786, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+"]
[66.187842, "o", "\r\n>>>Введите команду: "]
[75.305667, "o", "select from users where age = 28"]
[76.071998, "o", "\r\n"]
[76.072537, "o", "Функция select выполнилась за 0.000 секунд.\r\n"]
[76.07483, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+"]
[76.074865, "o", "\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n>>>Введите команду: "]
[85.178145, "o", "update users set age = 29 where name = \"Sergei\""]
[86.712559, "o", "\r\n"]
[86.712854, "o", "Запись с ID=1 в таблице \"users\" успешно обновлена.\r\n>>>Введите команду: "]
[98.210468, "o", "info users"]
[98.972712, "o", "\r\n"]
[98.973059, "o", "Таблица: users\r\n"]
[98.973084, "o", "Столбцы: ID:int, name:str, age:int, is_active:bool\r\n"]
[98.973119, "o", "Количество записей: 1\r\n"]
[98.973144, "o", ">>>Введите команду: "]
[109.95281, "o", "delete from users where ID = 1"]
[110.853077, "o", "\r\nВы уверены, что хотите выполнить \"удаление записи\"? [y/n]: "]
[112.717213, "o", "y"]
[113.329807, "o", "\r\n"]
[113.330432, "o", "Запись с ID=1 успешно удалена из таблицы \"users\".\r\n>>>Введите команду: "]
[122.20301, "o", "drop_table users"]
[122.957315, "o", "\r\n"]
[122.957636, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[124.293346, "o", "y"]
[125.459271, "o", "\r\n"]
[125.461369, "o", "Таблица \"users\" успешно удалена.\r\n>>>Введите команду: "]
[134.116132, "o", "e"]
